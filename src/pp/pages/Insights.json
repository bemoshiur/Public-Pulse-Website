34);\">Contact</a>\n\n</nav>\n<div style=\"display: flex; align-items: center; gap: 10px;\">\n<button type=\"button\" aria-label=\"Search the site\" aria-expanded=\"false\" style=\"width: 44px; height: 44px; border-radius: 999px; border: 1px solid rgba(242, 240, 234, 0.16); background: transparent; display: flex; align-items: center; justify-content: center; color: rgb(242, 240, 234); cursor: pointer; transition: border-color 0.3s, color 0.3s;\">\n<svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"7\"></circle><path d=\"M20 20l-3.5-3.5\"></path></svg>\n</button>\n<a class=\"btn btn-red btn-sm nav-book\" href=\"/book/\">Book a call\n<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14M13 6l6 6-6 6\"></path></svg>\n</a>\n<button type=\"button\" class=\"mob\" aria-label=\"Menu\" aria-expanded=\"false\" style=\"width: 44px; height: 44px; border-radius: 999px; border: 1px solid rgba(242, 240, 234, 0.2); background: transparent; color: rgb(242, 240, 234); align-items: center; justify-content: center; cursor: pointer;\">\n<svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M4 8h16M4 16h16\"></path></svg>\n</button>\n</div>\n</div>\n</header>\n\n\n\n\n</div>\n\n\n<section style=\"position: relative; padding: 80px 0px 60px; overflow: hidden;\">\n<div class=\"gridbg\" aria-hidden=\"true\"></div>\n<div class=\"wrap\" style=\"position: relative; display: flex; flex-direction: column; gap: 28px;\">\n<span class=\"mono fade-up\" style=\"font-size: 12px; color: rgb(158, 163, 155);\"><a href=\"/\" class=\"ulink\">Home</a> / Insights</span>\n<span class=\"eyebrow fade-up\" style=\"color: rgb(75, 227, 143);\">Insights</span>\n<div style=\"display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 40px;\">\n<h1 class=\"h-xxl\"><span class=\"word\">Notes</span> <span class=\"word\" style=\"animation-delay: 0.08s;\">from</span><br><span class=\"word\" style=\"animation-delay: 0.18s;\">the</span> <span class=\"word\" style=\"animation-delay: 0.26s; color: rgb(222, 42, 34); font-style: italic;\">studio.</span></h1>\n<div class=\"fade-up\" style=\"display: flex; gap: 40px; animation-delay: 0.5s;\">\n<div><span style=\"display: block; font-weight: 900; font-stretch: 125%; font-size: 88px; line-height: 0.85; letter-spacing: -0.05em; color: rgb(75, 227, 143);\">121</span><span class=\"mono\" style=\"font-size: 12px; letter-spacing: 0.12em; color: rgb(185, 189, 182);\">ARTICLES</span></div>\n<div><span style=\"display: block; font-weight: 900; font-stretch: 125%; font-size: 88px; line-height: 0.85; letter-spacing: -0.05em;\">10</span><span class=\"mono\" style=\"font-size: 12px; letter-spacing: 0.12em; color: rgb(185, 189, 182);\">CATEGORIES</span></div>\n</div>\n</div>\n</div>\n</section>\n\n<section style=\"padding: 20px 0px 40px; position: sticky; top: 76px; z-index: 5; background: rgba(11, 12, 11, 0.9); backdrop-filter: blur(12px); border-bottom: 1px solid rgba(242, 240, 234, 0.08);\">\n<div class=\"wrap\" style=\"display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 16px; padding-top: 0px;\">\n<div role=\"group\" aria-label=\"Topics\" style=\"display: flex; flex-wrap: wrap; gap: 8px;\">\n\n<button type=\"button\" aria-pressed=\"true\" style=\"min-height: 44px; padding: 0px 18px; border-radius: 999px; font-family: inherit; font-size: 14px; font-weight: 600; cursor: pointer; transition: 0.3s; border: 1px solid rgb(242, 240, 234); background: rgb(242, 240, 234); color: rgb(11, 12, 11);\">All</button>\n\n<button type=\"button\" aria-pressed=\"false\" style=\"min-height: 44px; padding: 0px 18px; border-radius: 999px; font-family: inherit; font-size: 14px; font-weight: 600; cursor: pointer; transition: 0.3s; border: 1px solid rgba(242, 240, 234, 0.2); background: transparent; color: rgb(242, 240, 234);\">Paid media</button>\n\n<button type=\"button\" aria-pressed=\"false\" style=\"min-height: 44px; padding: 0px 18px; border-radius: 999px; font-family: inherit; font-size: 14px; font-weight: 600; cursor: pointer; transition: 0.3s; border: 1px solid rgba(242, 240, 234, 0.2); background: transparent; color: rgb(242, 240, 234);\">SEO</button>\n\n<button type=\"button\" aria-pressed=\"false\" style=\"min-height: 44px; padding: 0px 18px; border-radius: 999px; font-family: inherit; font-size: 14px; font-weight: 600; cursor: pointer; transition: 0.3s; border: 1px solid rgba(242, 240, 234, 0.2); background: transparent; color: rgb(242, 240, 234);\">Hospitality marketing</button>\n\n<button type=\"button\" aria-pressed=\"false\" style=\"min-height: 44px; padding: 0px 18px; border-radius: 999px; font-family: inherit; font-size: 14px; font-weight: 600; cursor: pointer; transition: 0.3s; border: 1px solid rgba(242, 240, 234, 0.2); background: transparent; color: rgb(242, 240, 234);\">Brand building</button>\n\n</div>\n<label style=\"display: flex; align-items: center; gap: 10px; min-height: 48px; padding: 0px 18px; border-radius: 999px; border: 1px solid rgba(242, 240, 234, 0.2); flex: 0 1 320px;\">\n<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#9EA39B\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"7\"></circle><path d=\"M20 20l-3.5-3.5\"></path></svg>\n<span style=\"position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0px, 0px, 0px, 0px);\">Search articles</span>\n<input type=\"search\" placeholder=\"Search 121 articles\" style=\"flex: 1 1 0%; min-width: 0px; border: 0px; background: transparent; color: rgb(242, 240, 234); font-family: inherit; font-size: 15px; outline: none;\">\n</label>\n</div>\n</section>\n\n<section style=\"padding: 60px 0px 40px;\">\n<div class=\"wrap\" style=\"display: flex; flex-direction: column; gap: 28px;\">\n<div style=\"display: flex; justify-content: space-between; align-items: end; gap: 16px; flex-wrap: wrap;\">\n<h2 class=\"h-m rv\">Step-by-step playbooks</h2>\n<a class=\"ulink rv\" href=\"/guides/\" style=\"font-weight: 700;\">All guides →</a>\n</div>\n<div class=\"g3\">\n\n<a class=\"card rv\" href=\"/guides/\" style=\"text-decoration: none; padding: 28px; min-height: 320px; display: flex; flex-direction: column; justify-content: space-between; gap: 24px;\">\n<div style=\"display: flex; justify-content: space-between; align-items: center;\"><span class=\"chip\" style=\"border-color: rgb(222, 42, 34); color: rgb(222, 42, 34);\">HowTo</span><span class=\"mono\" style=\"font-size: 12px; color: rgb(158, 163, 155);\">2h30m</span></div>\n<div style=\"display: flex; flex-direction: column; gap: 12px;\">\n<h3 style=\"margin: 0px; font-weight: 800; font-stretch: 108%; font-size: 24px; line-height: 1.15; letter-spacing: -0.02em;\">How to run a Facebook ad campaign for a Bangladesh constituency election</h3>\n<p class=\"body\" style=\"font-size: 15px;\">Audience build, compliance and budget pacing for a constituency-targeted Meta campaign.</p>\n</div>\n</a>\n\n<a class=\"card rv\" href=\"/guides/\" style=\"text-decoration: none; padding: 28px; min-height: 320px; display: flex; flex-direction: column; justify-content: space-between; gap: 24px;\">\n<div style=\"display: flex; justify-content: space-between; align-items: center;\"><span class=\"chip\" style=\"border-color: rgb(75, 227, 143); color: rgb(75, 227, 143);\">HowTo</span><span class=\"mono\" style=\"font-size: 12px; color: rgb(158, 163, 155);\">1h</span></div>\n<div style=\"display: flex; flex-direction: column; gap: 12px;\">\n<h3 style=\"margin: 0px; font-weight: 800; font-stretch: 108%; font-size: 24px; line-height: 1.15; letter-spacing: -0.02em;\">Set up Meta Conversions API for a Bangladesh e-commerce site</h3>\n<p class=\"body\" style=\"font-size: 15px;\">Recover lost conversion signal with server-side tracking on Next.js, Shopify or WooCommerce.</p>\n</div>\n</a>\n\n<a class=\"card rv\" href=\"/guides/\" style=\"text-decoration: none; padding: 28px; min-height: 320px; display: flex; flex-direction: column; justify-content: space-between; gap: 24px;\">\n<div style=\"display: flex; justify-content: space-between; align-items: center;\"><span class=\"chip\" style=\"border-color: rgb(242, 240, 234); color: rgb(242, 240, 234);\">HowTo</span><span class=\"mono\" style=\"font-size: 12px; color: rgb(158, 163, 155);\">30m</span></div>\n<div style=\"display: flex; flex-direction: column; gap: 12px;\">\n<h3 style=\"margin: 0px; font-weight: 800; font-stretch: 108%; font-size: 24px; line-height: 1.15; letter-spacing: -0.02em;\">Add IndexNow to your publish pipeline</h3>\n<p class=\"body\" style=\"font-size: 15px;\">Notify Bing, Yandex and other engines the moment a page goes live.</p>\n</div>\n</a>\n\n</div>\n</div>\n</section>\n\n<section style=\"padding: 40px 0px 120px;\">\n<div class=\"wrap\" style=\"display: flex; flex-direction: column; gap: 28px;\">\n<div style=\"display: flex; justify-content: space-between; align-items: end; gap: 16px; flex-wrap: wrap;\">\n<h2 class=\"h-m rv\">Decision matrices</h2>\n<a class=\"ulink rv\" href=\"/compare/\" style=\"font-weight: 700;\">All comparisons →</a>\n</div>\n<div style=\"border-top: 1px solid rgba(242, 240, 234, 0.16);\">\n\n<a class=\"hov-row rv\" href=\"/compare/\" style=\"text-decoration: none; display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 32px 0px; border-bottom: 1px solid rgba(242, 240, 234, 0.16);\">\n<span style=\"display: flex; flex-direction: column; gap: 8px;\"><span style=\"font-weight: 800; font-stretch: 108%; font-size: clamp(20px, 2.2vw, 32px); letter-spacing: -0.02em;\">Integrated Agency vs In-house Marketing Team</span><span class=\"body\" style=\"font-size: 15px;\">Cost, speed, skill range, accountability and brand control for a Bangladesh brand.</span></span>\n<span style=\"width: 52px; height: 52px; flex-shrink: 0; border-radius: 999px; background: rgb(222, 42, 34); color: rgb(255, 255, 255); display: flex; align-items: center; justify-content: center;\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14M13 6l6 6-6 6\"></path></svg></span>\n</a>\n\n<a class=\"hov-row rv\" href=\"/compare/\" style=\"text-decoration: none; display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 32px 0px; border-bottom: 1px solid rgba(242, 240, 234, 0.16);\">\n<span style=\"display: flex; flex-direction: column; gap: 8px;\"><span style=\"font-weight: 800; font-stretch: 108%; font-size: clamp(20px, 2.2vw, 32px); letter-spacing: -0.02em;\">Facebook / Meta Ads vs Google Ads (Search + YouTube)</span><span class=\"body\" style=\"font-size: 15px;\">Reach and creator culture against intent-driven search: cost, audience, creative needs.</span></span>\n<span style=\"width: 52px; height: 52px; flex-shrink: 0; border-radius: 999px; background: rgb(222, 42, 34); color: rgb(255, 255, 255); display: flex; align-items: center; justify-content: center;\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14M13 6l6 6-6 6\"></path></svg></span>\n</a>\n\n<a class=\"hov-row rv\" href=\"/compare/\" style=\"text-decoration: none; display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 32px 0px; border-bottom: 1px solid rgba(242, 240, 234, 0.16);\">\n<span style=\"display: flex; flex-direction: column; gap: 8px;\"><span style=\"font-weight: 800; font-stretch: 108%; font-size: clamp(20px, 2.2vw, 32px); letter-spacing: -0.02em;\">Boosting vs Ads Manager</span><span class=\"body\" style=\"font-size: 15px;\">When a boosted post is enough for a political campaign, and when you need Ads Manager.</span></span>\n<span style=\"width: 52px; height: 52px; flex-shrink: 0; border-radius: 999px; background: rgb(222, 42, 34); color: rgb(255, 255, 255); display: flex; align-items: center; justify-content: center;\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14M13 6l6 6-6 6\"></path></svg></span>\n</a>\n\n</div>\n</div>\n</section>\n\n\n<footer class=\"pp\" style=\"background: rgb(11, 12, 11);\">\n\n<section style=\"padding: 120px 0px 0px; overflow: hidden; border-top: 1px solid rgba(242, 240, 234, 0.08);\">\n<div class=\"wrap\" style=\"display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 24px; padding-bottom: 48px;\">\n<div style=\"display: flex; flex-direction: column; gap: 14px;\">\n<span class=\"eyebrow\" style=\"color: rgb(75, 227, 143);\">Got a project?</span>\n<span style=\"font-size: 18px; color: rgb(185, 189, 182); max-width: 420px; line-height: 1.5;\">Free 30-minute consultation. No deck, no pitch.</span>\n</div>\n<a class=\"btn btn-red\" href=\"/contact/\" style=\"min-height: 60px; padding: 0px 32px; font-size: 18px;\">Start a project\n<svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14M13 6l6 6-6 6\"></path></svg>\n</a>\n</div>\n<a href=\"/contact/\" aria-label=\"Let's talk — start a project\" style=\"display: block; text-decoration: none; color: rgb(242, 240, 234); border-top: 1px solid rgba(242, 240, 234, 0.08); border-bottom: 1px solid rgba(242, 240, 234, 0.08); padding: 2